---
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/700.css';
import '@fontsource/raleway/900.css';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatIcon from '../components/ChatIcon.astro';
import SalesRepRegionSelector from '../components/SalesRepRegionSelector.astro';

import raleway300 from '@fontsource/raleway/files/raleway-latin-300-normal.woff2?url';
import raleway400 from '@fontsource/raleway/files/raleway-latin-400-normal.woff2?url';
import raleway500 from '@fontsource/raleway/files/raleway-latin-500-normal.woff2?url';
import raleway700 from '@fontsource/raleway/files/raleway-latin-700-normal.woff2?url';
import raleway900 from '@fontsource/raleway/files/raleway-latin-900-normal.woff2?url';

const { description = "E3 Entegral Solutions provides design-build energy efficiency solutions, LED lighting, HVAC, and water conservation upgrades for Texas public facilities.", wpPostId } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
        
        <!-- Preload critical fonts to eliminate unstyled text layout shift (FOUT) -->
        <link rel="preload" href={raleway300} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={raleway400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={raleway500} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={raleway700} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={raleway900} as="font" type="font/woff2" crossorigin />

		<link rel="preconnect" href="https://descriptive-goldfish.flywheelstaging.com" crossorigin />
        {wpPostId && <meta name="wp-post-id" content={wpPostId} />}
		<title>E3 Entegral Solutions</title>
        <slot name="head" />
        <script is:inline>
            // Intercept internal links on Staging and route them through the loading screen
            document.addEventListener('DOMContentLoaded', () => {
                if (window.location.hostname.includes('workers.dev') || window.location.hostname.includes('localhost')) {
                    const rewriteLinks = () => {
                        document.querySelectorAll('a').forEach(link => {
                            const href = link.getAttribute('href');
                            if (!href || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('#')) return;
                            
                            try {
                                const url = new URL(link.href);
                                // If it's an internal link and not already pointing to preview
                                if (url.hostname === window.location.hostname && !url.pathname.startsWith('/preview')) {
                                    const targetPath = url.pathname + url.search + url.hash;
                                    // Rewrite the actual href attribute so "Open in new tab" and hover tooltips work
                                    link.href = '/preview?url=' + encodeURIComponent(targetPath);
                                }
                            } catch (err) {}
                        });
                    };
                    
                    // Run on initial load
                    rewriteLinks();
                    
                    // Run again if new elements are added to the DOM (like Astro view transitions or dynamic components)
                    document.addEventListener('astro:page-load', rewriteLinks);
                }
            });
        </script>
	</head>
	<body>
        <Header />
		<slot />
        <Footer />
        <ChatIcon />
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });

                const mapElements = document.querySelectorAll('.texas-svg-map');
                mapElements.forEach(el => observer.observe(el));
            });
        </script>
        <SalesRepRegionSelector />
        <script is:inline>
          function initVideoOverlays() {
            const videoWrappers = document.querySelectorAll('.db-video-wrapper, .video-embed__wrapper, .video-block, .wp-block-e3es-video-embed');
            
            videoWrappers.forEach((wrapper) => {
              const hideOverlay = () => {
                wrapper.classList.add('is-playing', 'hidden');
                const iframe = wrapper.querySelector('iframe');
                if (iframe && iframe.src && !iframe.src.includes('autoplay=1')) {
                  const separator = iframe.src.includes('?') ? '&' : '?';
                  iframe.src = iframe.src + separator + 'autoplay=1';
                }
              };

              wrapper.addEventListener('click', hideOverlay);
              
              const overlayBtn = wrapper.querySelector('.video-block__play-btn, .video-block__overlay, .video-embed__play-btn');
              if (overlayBtn) {
                overlayBtn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  hideOverlay();
                });
              }

              window.addEventListener('blur', () => {
                setTimeout(() => {
                  if (document.activeElement && document.activeElement.tagName === 'IFRAME') {
                    if (wrapper.contains(document.activeElement)) {
                      hideOverlay();
                    }
                  }
                }, 100);
              });

              window.addEventListener('message', (event) => {
                try {
                  const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
                  if (data && (data.event === 'play' || data.event === 'playing' || data.method === 'play')) {
                    hideOverlay();
                  }
                } catch (e) {}
              });
            });
          }

          document.addEventListener('DOMContentLoaded', initVideoOverlays);
          document.addEventListener('astro:page-load', initVideoOverlays);
        </script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		display: flex;
		flex-direction: column;
	}
</style>
