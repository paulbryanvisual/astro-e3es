<script>
  class TexasRegionSelector extends HTMLElement {
    regionMap: any = {};
    employees: any = {};
    isLocked: boolean = false;
    lockedRegionId: string | null = null;

    connectedCallback() {
      const template = document.getElementById('texas-map-template') as HTMLTemplateElement;
      if (!template) return;
      
      const content = template.content.cloneNode(true);
      
      try {
        const regionMapRaw = this.dataset.regionMapB64 ? atob(this.dataset.regionMapB64) : (this.dataset.regionMap || '{}');
        const employeesRaw = this.dataset.employeesB64 ? atob(this.dataset.employeesB64) : (this.dataset.employees || '{}');
        
        this.regionMap = JSON.parse(regionMapRaw);
        this.employees = JSON.parse(employeesRaw);
      } catch (e) {
        console.error("Failed to parse map data:", e);
        this.regionMap = {};
        this.employees = {};
      }
      
      this.appendChild(content);
      
      this.setupInteractions();
    }
    
    setupInteractions() {
      const regions = this.querySelectorAll('.texas-region');
      regions.forEach(region => {
        const regionId = (region as HTMLElement).dataset.region || '';

        const handleSelect = (e: Event) => {
          e.stopPropagation();

          // 1 & 2: Re-clicking locked region does NOT unlock or clear
          if (this.isLocked && this.lockedRegionId === regionId) {
            (region as HTMLElement).focus();
            return;
          }

          // 3: Clicking a different region locks the new selection in place
          if (regionId) {
            this.lockRegion(regionId, region as HTMLElement);
          }
        };

        region.addEventListener('click', handleSelect);

        region.addEventListener('mouseenter', () => {
          if (this.isLocked) return;
          if (regionId) {
            this.showRep(regionId);
            regions.forEach(r => r.classList.remove('active'));
            region.classList.add('active');
          }
        });

        region.addEventListener('mouseleave', () => {
          if (this.isLocked) return;
          regions.forEach(r => r.classList.remove('active'));
          this.showRep('');
        });
      });
    }

    lockRegion(regionId: string, regionElement: HTMLElement) {
      const regions = this.querySelectorAll('.texas-region');
      this.isLocked = true;
      this.lockedRegionId = regionId;

      regions.forEach(r => r.classList.remove('active'));
      regionElement.classList.add('active');
      this.showRep(regionId);

      if (window.innerWidth < 768) {
        const repCard = this.querySelector('.info-column');
        if (repCard) {
          repCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    }
    
    showRep(regionId: string) {
      const repId = this.regionMap[regionId];
      const rep = this.employees[repId];
      const repCard = this.querySelector('.rep-card') as HTMLElement;
      const placeholder = this.querySelector('.placeholder-card') as HTMLElement;
      
      if (!repCard || !placeholder) return;
      
      if (rep) {
        placeholder.style.display = 'none';
        repCard.style.display = 'flex';
        
        const nameEl = this.querySelector('.rep-name');
        if (nameEl) nameEl.textContent = rep.name;
        
        const roleEl = this.querySelector('.rep-role');
        if (roleEl) roleEl.textContent = rep.role || '';
        
        const emailEl = this.querySelector('.rep-email') as HTMLAnchorElement;
        if (emailEl) emailEl.href = 'mailto:' + (rep.email || 'info@e3es.com');
        
        const imgEl = this.querySelector('.rep-image') as HTMLImageElement;
        if (imgEl) {
          if (rep.imageUrl) {
            imgEl.src = rep.imageUrl;
            imgEl.style.display = 'block';
          } else {
            imgEl.style.display = 'none';
          }
        }
        
        const regionLabels: Record<string, string> = {
          panhandle: 'Panhandle / West Texas',
          north: 'North Texas',
          central: 'Central Texas',
          south: 'South Texas',
          west: 'Far West Texas',
          'hill-country': 'Hill Country',
          southeast: 'South East Texas',
          northeast: 'North East Texas'
        };
        
        const labelEl = this.querySelector('.rep-region-label');
        if (labelEl) labelEl.textContent = (regionLabels[regionId] || 'Regional') + ' Representative';
        
      } else {
        placeholder.style.display = 'block';
        repCard.style.display = 'none';
        placeholder.innerHTML = '<h3>Find your Rep!</h3><p>Select your region and contact us to get started.</p>';
      }
    }
  }
  
  if (!customElements.get('e3-texas-region-selector')) {
    customElements.define('e3-texas-region-selector', TexasRegionSelector);
  }
</script>

