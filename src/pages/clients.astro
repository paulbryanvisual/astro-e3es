---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPageBySlug, processWordPressHtml } from '../lib/wordpress';

const page = await getPageBySlug('clients');
if (!page) {
    return Astro.redirect('/404');
}

const optimizedContent = processWordPressHtml(page.content.rendered, 'clients');

const breadcrumbItems = [
  {
    label: "Home",
    href: "/",
    dropdown: [
      { label: "Solutions for K-12", href: "/k12" },
      { label: "Design+Build", href: "/design-build" },
      { label: "Partners in Funding", href: "/funding" },
      { label: "Clients", href: "/clients" },
      { label: "Services", href: "/services" }
    ]
  },
  {
    label: "Clients"
  }
];
---

<Layout wpPostId={page.id}>
    <Breadcrumb items={breadcrumbItems} />
    <main class="clients-page">
        <div class="clients-page__content" style="padding-top: 0;" set:html={optimizedContent} />
    </main>
</Layout>
