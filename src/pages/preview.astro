---
// PREVIEW LOADER ROUTE
// This page is intentionally static (no Astro.props or WordPress fetching)
// so it returns a 200 OK instantly. It uses a client-side script to
// redirect the user to the real URL so they see a loading spinner while
// the worker fetches data in the background.

export const prerender = false; // We still want it dynamic so we don't cache parameters if we don't need to, but it does no fetching.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loading Staging...</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .loader-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid #e2e8f0;
      border-top: 4px solid #0056b3;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    .text {
      color: #334155;
      font-size: 1.125rem;
      font-weight: 500;
    }
    .subtext {
      color: #64748b;
      font-size: 0.875rem;
      max-width: 300px;
      text-align: center;
      line-height: 1.4;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="loader-container">
    <div class="spinner"></div>
    <div class="text">Waking up Staging...</div>
    <div class="subtext" id="target-display">Requesting page from WordPress. This can take a few seconds on the staging environment.</div>
  </div>

  <script>
    // Get the target URL from the query string
    const params = new URLSearchParams(window.location.search);
    const targetUrl = params.get('url');

    if (targetUrl) {
      // Normalize URL: ensure it starts with a single slash
      let safeUrl = targetUrl;
      if (!safeUrl.startsWith('/')) {
        safeUrl = '/' + safeUrl;
      }

      // Validate it doesn't start with double slashes (e.g. //evil.com) to prevent open redirects
      if (safeUrl.startsWith('//')) {
        document.getElementById('target-display').innerText = 'Invalid target URL specified (cannot be absolute).';
        document.querySelector('.spinner').style.display = 'none';
      } else {
        document.getElementById('target-display').innerText = `Building page: ${safeUrl}\nThis can take a few seconds on the staging environment.`;
        // Redirect the browser to the actual page. 
        // The browser will show this loading screen until the new page finishes downloading.
        window.location.replace(safeUrl);
      }
    } else {
      document.getElementById('target-display').innerText = 'No target URL specified. Please use the WordPress admin buttons.';
      document.querySelector('.spinner').style.display = 'none';
    }
  </script>
</body>
</html>
