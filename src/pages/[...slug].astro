---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPages, getServices, processWordPressHtml, buildBreadcrumbs, getPageBySlug, getServiceBySlug, getHierarchy } from '../lib/wordpress';

export async function getStaticPaths() {
  const [pages, services] = await Promise.all([getPages(), getServices()]);
  const allItems = [...pages, ...services];
  
  const pagePaths = pages.map((page: any) => {
    try {
      const url = new URL(page.link);
      let path = url.pathname.replace(/^\/|\/$/g, '');
      path = path.replace(/^home\/industries\//, '');
      path = path.replace(/^home\/our-approach\//, '');
      path = path.replace(/^home\/about-us\//, '');
      path = path.replace(/^home\//, '');
      // Skip the homepage and other reserved single pages that have their own astro templates
      if (!path || path === 'home' || path === 'clients') {
        return null;
      }
      
      return {
        params: { slug: path },
        props: { page, allItems }
      };
    } catch (e) {
      // Fallback to simple slug if link parsing fails
      if (!page.slug || page.slug === 'home' || page.slug === 'clients') {
        return null;
      }
      return {
        params: { slug: page.slug },
        props: { page, allItems }
      };
    }
  }).filter(Boolean);

  const servicePaths = services.map((service: any) => {
    try {
      const url = new URL(service.link);
      const path = url.pathname.replace(/^\/|\/$/g, '');
      
      if (!path) {
        return null;
      }
      
      return {
        params: { slug: path },
        props: { page: service, allItems }
      };
    } catch (e) {
      if (!service.slug) {
        return null;
      }
      const fallbackSlug = `services/${service.slug}`;
      return {
        params: { slug: fallbackSlug },
        props: { page: service, allItems }
      };
    }
  }).filter(Boolean);

  return [...pagePaths, ...servicePaths];
}

let { page, allItems } = Astro.props;

if (!page) {
  const slug = Astro.params.slug || '';
  // Remove any trailing slash before splitting
  const trimmedSlug = slug.replace(/\/$/, '');
  const finalSlug = trimmedSlug.split('/').pop() || trimmedSlug;
  try {
    if (slug.startsWith('services/')) {
      page = await getServiceBySlug(finalSlug);
    } else {
      page = await getPageBySlug(finalSlug);
      if (!page) {
        page = await getServiceBySlug(finalSlug);
      }
    }
  } catch (err: any) {
    console.error(`SSR Fetch Error for slug ${finalSlug}:`, err);
    return new Response(`
      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Staging Environment Waking Up...</title>
        <style>
          body { font-family: system-ui, sans-serif; text-align: center; padding: 4rem; color: #333; }
          .container { max-width: 500px; margin: 0 auto; background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
          h1 { font-size: 1.5rem; color: #d32f2f; }
          p { margin: 1rem 0; line-height: 1.5; color: #555; }
          button { background: #0056b3; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-size: 1rem; }
          button:hover { background: #004494; }
        </style>
      </head>
      <body>
        <div class="container">
          <h1>Backend Server Timeout</h1>
          <p>The WordPress Staging server took too long to respond or is currently waking up. Please wait 10 seconds and try again.</p>
          <p><small>${err.message || 'Unknown error'}</small></p>
          <button id="refreshBtn" onclick="window.location.reload()" disabled>Refresh Page in 10s</button>
        </div>
        <script>
          let seconds = 10;
          const btn = document.getElementById('refreshBtn');
          const interval = setInterval(() => {
            seconds--;
            if (seconds > 0) {
              btn.innerText = 'Refresh Page in ' + seconds + 's';
            } else {
              clearInterval(interval);
              btn.innerText = 'Refreshing...';
              window.location.reload();
            }
          }, 1000);
        </script>
      </body>
      </html>
    `, { 
      status: 503,
      headers: { 'Content-Type': 'text/html' }
    });
  }
}

if (!page) {
  return new Response('Page Not Found', { status: 404 });
}

if (!allItems) {
  allItems = await getHierarchy();
}

const optimizedContent = processWordPressHtml(page.content.rendered, page.slug);
const breadcrumbs = buildBreadcrumbs(page, allItems);

---

<Layout wpPostId={page.id}>
    <!-- Breadcrumb Bar -->
    <Breadcrumb items={breadcrumbs} />
    <!-- Main Content (Intro Banner is now handled natively via the WordPress Block inside optimizedContent) -->
    <main class="services-page">
        <div class="services-page__container">
            <div class="services-page__content" style="padding-top: 0;" set:html={optimizedContent} />
        </div>
    </main>
</Layout>
