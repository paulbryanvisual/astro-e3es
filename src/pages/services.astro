---
import Layout from '../layouts/Layout.astro';
import LeadFormDrawer from '../components/LeadFormDrawer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getServices, getPages, getPageById, buildBreadcrumbs } from '../lib/wordpress';

const [servicesPage, pages, allServices] = await Promise.all([
    getPageById(11),
    getPages(),
    getServices()
]);
const allItems = [...pages, ...allServices];
const breadcrumbs = buildBreadcrumbs(servicesPage, allItems);

// Canonical list and order of Primary Service Index Pages
const canonicalParentSlugs = [
    'hvac',
    'lighting',
    'electrical',
    'water',
    'roofing',
    'indoor-air-quality',
    'energy-management',
    'facility-assessments',
    'building-envelope',
    'planning-bond-advisory-services'
];

const serviceMap = new Map();
allServices.forEach(s => {
    if (canonicalParentSlugs.includes(s.slug)) {
        serviceMap.set(s.slug, s);
    }
});

const parentServices = canonicalParentSlugs
    .map(slug => serviceMap.get(slug))
    .filter(Boolean);

// Fallback images per service type
const serviceFallbacks: Record<string, string> = {
    'hvac': '/images/hvac-500x220.jpg',
    'lighting': '/images/led-lighting_hero.jpg',
    'electrical': '/images/electrical-services.jpg',
    'water': '/images/water-wells.jpg',
    'roofing': '/images/roofing-services.jpg',
    'indoor-air-quality': '/images/indoor-air-quality.jpg',
    'energy-management': '/images/automation.jpg',
    'facility-assessments': '/images/facility-assessments.jpg',
    'building-envelope': '/images/building-envelope.jpg',
    'planning-bond-advisory-services': '/images/planning-bond-advisory.jpg'
};

function getCardImage(service: any) {
    // 1. Featured image from WordPress embedded media
    const featured = service._embedded?.['wp:featuredmedia']?.[0]?.source_url;
    if (featured) {
        return featured.replace(/https?:\/\/[^\/]+\/wp-content/gi, '/wp-content');
    }
    
    // 2. First img tag in rendered content
    const content = service.content?.rendered || '';
    const imgMatch = content.match(/<img[^>]+src=["']([^"']+)["']/i);
    if (imgMatch) {
        return imgMatch[1].replace(/https?:\/\/[^\/]+\/wp-content/gi, '/wp-content');
    }

    // 3. Subject-matched fallback
    return serviceFallbacks[service.slug] || '/images/hvac-500x220.jpg';
}

function getExploreButtonText(slug: string, titleText: string) {
    const customNames: Record<string, string> = {
        'hvac': 'Explore HVAC Services',
        'lighting': 'Explore LED Services',
        'electrical': 'Explore Electrical Services',
        'water': 'Explore Water Services',
        'roofing': 'Explore Roofing Services',
        'indoor-air-quality': 'Explore IAQ Services',
        'energy-management': 'Explore Energy Management Services',
        'facility-assessments': 'Explore Facility Assessments',
        'building-envelope': 'Explore Building Envelope Services',
        'planning-bond-advisory-services': 'Explore Planning & Bond Services'
    };
    return (customNames[slug] || `Explore ${titleText} Services`) + ' &rarr;';
}
---

<Layout wpPostId={11}>
    <!-- Breadcrumb Bar -->
    <Breadcrumb items={breadcrumbs} />
    <section class="db-page-hero" style="background-image: linear-gradient(rgba(14, 27, 43, 0.7), rgba(14, 27, 43, 0.8)), url('/images/E3-background-layered-1920x1080-1920x1080-1920x1080-1920x1080-1920x1080-1920x1080.jpg'); padding: 4rem 2rem;">
        <div class="db-page-hero__container">
            <h1 class="db-page-hero__title" style="margin-bottom: 1rem;">Our Turnkey Services</h1>
            <div class="db-page-hero__intro">
                <p style="margin-bottom: 0;">Explore E3's comprehensive turnkey engineering services designed to modernize Texas school districts, hospitals, and municipal facilities with zero upfront capital.</p>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services" style="padding-top: 4rem;">
        <div class="services__container">
            <div class="services__grid">
                {parentServices.map(service => {
                    const cardImage = getCardImage(service);
                    const url = `/services/${service.slug}/`;
                    const title = service.title?.rendered || service.slug;
                    const excerpt = service.excerpt?.rendered || service.meta?._e3_service_excerpt || service.meta?.service_excerpt || 'Explore turnkey design-build infrastructure solutions.';
                    const btnLabel = getExploreButtonText(service.slug, service.title?.rendered || '');
                    
                    return (
                        <a href={url} class="services__card">
                            <img src={cardImage} alt={title} class="services__card-image" loading="lazy" />
                            <div class="services__card-content">
                                <h3 class="services__card-title" set:html={title}></h3>
                                <div class="services__card-text" set:html={excerpt}></div>
                                <span class="services__card-link" set:html={btnLabel}></span>
                            </div>
                        </a>
                    );
                })}
            </div>
        </div>
    </section>

    <LeadFormDrawer />
</Layout>
