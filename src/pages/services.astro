---
import Layout from '../layouts/Layout.astro';
import LeadFormDrawer from '../components/LeadFormDrawer.astro';
import { getServices } from '../lib/wordpress';
import { Image } from 'astro:assets';

const allServices = await getServices();
const excludeSlugs = ['k-12', 'municipal', 'healthcare', 'higher-education', 'buyboard', 'tips', 'job-order-contracting', 'energy-savings-performance-contracting', 'seco', 'water-2__trashed', 'hvac-2__trashed', 'higher-ed__trashed', 'controls', 'wastewater', 'water-treatment'];

// Try to only show services that are active, not trashed, and not industries
const parentServices = allServices.filter(s => 
    (s.parent === 0 || !s.parent) && 
    !excludeSlugs.includes(s.slug) &&
    !s.slug.includes('__trashed')
);

// Fallback image if no featured image is set
const fallbackImage = "/images/hvac-500x220.jpg";
---

<Layout wpPostId={11}>
    <section class="db-page-hero" style="background-image: linear-gradient(rgba(14, 27, 43, 0.7), rgba(14, 27, 43, 0.8)), url('/images/E3-background-layered-1920x1080-1920x1080-1920x1080-1920x1080-1920x1080-1920x1080.jpg'); padding: 4rem 2rem;">
        <div class="db-page-hero__container">
            <h1 class="db-page-hero__title" style="margin-bottom: 1rem;">Our Turnkey Services</h1>
            <div class="db-page-hero__intro">
                <p style="margin-bottom: 0;">We provide comprehensive, start-to-finish solutions designed to modernize your facilities, reduce energy consumption, and eliminate deferred maintenance.</p>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services" style="padding-top: 4rem;">
        <div class="services__container">
            <div class="services__grid">
                {parentServices.map(service => {
                    const featuredMedia = service._embedded?.['wp:featuredmedia']?.[0]?.source_url || fallbackImage;
                    const url = new URL(service.link).pathname;
                    const excerpt = service.excerpt?.rendered || service.meta?._e3_service_excerpt || service.meta?.service_excerpt || '';
                    
                    return (
                        <a href={url} class="services__card">
                            <img src={featuredMedia} alt={service.title.rendered} class="services__card-image" loading="lazy" />
                            <div class="services__card-content">
                                <h3 class="services__card-title" set:html={service.title.rendered}></h3>
                                {excerpt && (
                                    <div class="services__card-text" set:html={excerpt}></div>
                                )}
                                <span class="services__card-link">Learn More →</span>
                            </div>
                        </a>
                    );
                })}
            </div>
        </div>
    </section>

    <LeadFormDrawer />
</Layout>
